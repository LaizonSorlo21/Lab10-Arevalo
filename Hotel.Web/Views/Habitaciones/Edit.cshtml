@model Hotel.Web.Models.Habitacion
@{ ViewData["Title"] = "Editar habitación"; }
<div class="row justify-content-center"><div class="col-lg-6"><h1 class="page-title">Editar habitación @Model.Numero</h1><p class="text-secondary">Actualiza sus datos principales.</p><div class="card border-0 shadow-sm"><div class="card-body p-4"><form asp-action="Edit" method="post"><input type="hidden" asp-for="IdHabitacion" /><partial name="_Form" model="Model" /><button class="btn btn-primary" type="submit">Guardar cambios</button><a class="btn btn-link" asp-action="Index">Volver</a></form></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
