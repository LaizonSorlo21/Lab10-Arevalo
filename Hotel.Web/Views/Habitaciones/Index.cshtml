@model IEnumerable<Hotel.Web.Models.Habitacion>
@{ ViewData["Title"] = "Habitaciones"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="page-title mb-1">Habitaciones</h1><p class="text-secondary mb-0">Habitaciones activas ordenadas por número.</p></div>
    <a class="btn btn-primary" asp-action="Create">Nueva habitación</a>
</div>

<form method="get" class="card border-0 shadow-sm mb-4">
    <div class="card-body row g-3 align-items-end">
        <div class="col-md-5"><label class="form-label" for="idTipoHabitacion">Tipo de habitación</label><select class="form-select" id="idTipoHabitacion" name="idTipoHabitacion" asp-items="ViewBag.IdTipoHabitacion"><option value="">Todos los tipos</option></select></div>
        <div class="col-auto"><button class="btn btn-outline-primary" type="submit">Filtrar</button></div>
        <div class="col-auto"><a class="btn btn-link" asp-action="Index">Limpiar</a></div>
    </div>
</form>

<div class="card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive"><table class="table table-hover mb-0">
        <thead class="table-light"><tr><th>Número</th><th>Piso</th><th>Tipo</th><th>Capacidad</th><th>Precio por noche</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr><td class="fw-semibold">@item.Numero</td><td>@item.Piso</td><td>@item.IdTipoHabitacionNavigation.Nombre</td><td>@item.IdTipoHabitacionNavigation.Capacidad persona(s)</td><td>S/ @item.IdTipoHabitacionNavigation.PrecioNoche.ToString("N2")</td><td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.IdHabitacion">Detalle</a> <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.IdHabitacion">Editar</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.IdHabitacion">Desactivar</a></td></tr>
        }
        </tbody>
    </table></div>
    @if (!Model.Any()) { <div class="p-4 text-center text-secondary">No se encontraron habitaciones activas.</div> }
</div>
