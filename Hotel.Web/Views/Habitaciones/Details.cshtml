@model Hotel.Web.Models.Habitacion
@{ ViewData["Title"] = "Detalle de habitación"; }
<h1 class="page-title">Habitación @Model.Numero</h1><p class="text-secondary">Información completa de la habitación.</p>
<div class="card border-0 shadow-sm col-lg-7"><div class="card-body p-4"><dl class="row mb-0"><dt class="col-sm-4">Número</dt><dd class="col-sm-8">@Model.Numero</dd><dt class="col-sm-4">Piso</dt><dd class="col-sm-8">@Model.Piso</dd><dt class="col-sm-4">Tipo</dt><dd class="col-sm-8">@Model.IdTipoHabitacionNavigation.Nombre</dd><dt class="col-sm-4">Capacidad</dt><dd class="col-sm-8">@Model.IdTipoHabitacionNavigation.Capacidad persona(s)</dd><dt class="col-sm-4">Precio por noche</dt><dd class="col-sm-8">S/ @Model.IdTipoHabitacionNavigation.PrecioNoche.ToString("N2")</dd><dt class="col-sm-4">Estado</dt><dd class="col-sm-8">@(Model.Activo ? "Activa" : "Inactiva")</dd></dl><hr /><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.IdHabitacion">Editar</a><a class="btn btn-link" asp-action="Index">Volver</a></div></div>
